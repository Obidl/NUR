NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/nur?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32
# Used as HMAC pepper when hashing opaque refresh tokens (not a JWT signer).
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated exact origins. Never use * (credentials enabled).
CORS_ORIGIN=http://localhost:5173
# Optional — leave empty locally; set in Render for production error tracking.
SENTRY_DSN=
# Optional password-reset email (Resend). All three required to send mail in production.
RESEND_API_KEY=
EMAIL_FROM=NUR <onboarding@resend.dev>
WEB_APP_URL=https://nur-web-orcin.vercel.app
